+			for(int j = 0; j < 8; j++)
+			{
+				acc[j] += coef * temp[8 * k + j];
+			}
+		}
+		for(int j = 0; j < 8; j++)
+		{
+			output[8 * i + j] = static_cast<int16>(floorf(acc[j] + 0.5f));
