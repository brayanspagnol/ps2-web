+		for(int k = 0; k < 8; k++)
+		{
+			float value = input[8 * i + k];
+			for(int j = 0; j < 8; j++)
+			{
+				acc[j] += coefs[k * 8 + j] * value;
+			}
+		}
+		for(int j = 0; j < 8; j++)
