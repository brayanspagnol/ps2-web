# Emulator source lives in its own repo (fork of jpd002/Play-)
/play-src/
/play-*/

# The user's own game dumps never go into the repo
/games/*
!/games/README.txt

# Throwaway emulator variants for A/B tests (public/emu/ is the shipped build)
/public/emu-*/

__pycache__/
isolate-*-v8.log

# Optional user-supplied boot intro video / sound / logo (never Sony assets in the repo)
/public/assets/ps2-boot.*
/public/assets/ps2-logo.*

# The user's own console BIOS dump never goes into the repo
/bios/
